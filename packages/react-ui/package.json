{
	"name": "@packages/react-components",
	"version": "0.0.2",
	"type": "module",
	"license": "MIT",
	"author": "ph.duy113@gmail.com",
	"description": "THis is a UI component library for building React application",
	"keywords": [
		"react",
		"components",
		"ui"
	],
	"scripts": {
		"type-check": "tsc --build --noEmit",
		"build": " vite build",
		"lint": "eslint .",
		"format": "prettier --write .",
		"preview": "vite preview",
		"prepack": "clean-package",
		"postpack": "clean-package restore",
		"prepublishOnly": "npm run build",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test-storybook": "vitest --project=storybook",
		"test:ci": "vitest run --coverage",
		"coverage-report": "http-server ./coverage -p 9000"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./components": {
			"types": "./dist/components/index.d.ts",
			"default": "./dist/components/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/phamhaduy95/UI-components.git",
		"directory": "packages/react-ui"
	},
	"bugs": {
		"url": "https://github.com/phamhaduy95/react-component-lib/issues"
	},
	"homepage": "https://github.com/phamhaduy95/react-component-lib#readme",
	"files": [
		"dist"
	],
	"dependencies": {
		"@ark-ui/react": "^5.34.1",
		"@radix-ui/react-icons": "^1.3.2",
		"dayjs": "^1.11.19",
		"react": "^19.2.4",
		"react-dom": "^19.2.4"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.0.1",
		"@configs/eslint-config": "workspace:*",
		"@packages/styles": "workspace:*",
		"@storybook/addon-a11y": "^10.2.16",
		"@storybook/addon-docs": "^10.2.16",
		"@storybook/addon-vitest": "^10.2.16",
		"@storybook/react-vite": "^10.2.16",
		"@tailwindcss/vite": "^4.2.1",
		"@types/node": "^22.19.15",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@typescript-eslint/eslint-plugin": "^8.56.1",
		"@typescript-eslint/parser": "^6.21.0",
		"@vitejs/plugin-react-swc": "^3.11.0",
		"@vitest/browser-playwright": "4.0.18",
		"@vitest/coverage-v8": "4.0.18",
		"classnames": "^2.5.1",
		"clean-package": "^2.2.0",
		"eslint": "^10.0.3",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"globby": "^16.1.1",
		"http-server": "^14.1.1",
		"lightningcss": "^1.31.1",
		"playwright": "^1.58.2",
		"storybook": "^10.2.16",
		"tailwindcss": "^4.2.1",
		"vite": "^7.3.1",
		"vite-plugin-dts": "^4.5.4",
		"vite-plugin-lib-inject-css": "^2.2.2",
		"vitest": "^4.0.18"
	},
	"peerDependencies": {
		"react": ">=18.0.0",
		"react-dom": ">=18.0.0"
	},
	"sideEffects": [
		"**/*.css"
	]
}
