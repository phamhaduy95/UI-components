{
	"name": "vue-ui",
	"version": "0.0.1",
	"type": "module",
	"license": "MIT",
	"author": "ph.duy113@gmail.com",
	"description": "THis is a UI component library for building Vue application",
	"keywords": [
		"vue",
		"components",
		"ui"
	],
	"scripts": {
		"build": "vite build",
		"lint": "eslint .",
		"format": "prettier --write .",
		"type-check": "vue-tsc --build",
		"test": "vitest",
		"test-storybook": "vitest --project=storybook",
		"test:ci": "vitest run --coverage",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"coverage-report": "http-server ./coverage -p 9000"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./components": {
			"types": "./dist/components/index.d.ts",
			"default": "./dist/components/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/phamhaduy95/UI-components.git",
		"directory": "packages/vue-ui"
	},
	"bugs": {
		"url": "https://github.com/phamhaduy95/UI-components/issues"
	},
	"homepage": "https://github.com/phamhaduy95/UI-components#readme",
	"files": [
		"dist"
	],
	"dependencies": {
		"@ark-ui/vue": "^5.32.0",
		"@heroicons/vue": "^2.2.0",
		"@packages/styles": "workspace:*",
		"vue": "^3.5.28"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.0.1",
		"@configs/eslint-config": "workspace:*",
		"@storybook/addon-a11y": "^10.2.10",
		"@storybook/addon-docs": "^10.2.10",
		"@storybook/addon-vitest": "^10.2.10",
		"@storybook/vue3-vite": "^10.2.10",
		"@tailwindcss/vite": "^4.1.18",
		"@tsconfig/node24": "^24.0.4",
		"@types/node": "^24.10.13",
		"@vitejs/plugin-vue": "^6.0.4",
		"@vitejs/plugin-vue-jsx": "^5.1.4",
		"@vitest/browser-playwright": "4.0.18",
		"@vitest/coverage-v8": "4.0.18",
		"@vue/tsconfig": "^0.8.1",
		"eslint": "^10.0.2",
		"eslint-plugin-vue": "^10.8.0",
		"globals": "^17.3.0",
		"globby": "^16.1.1",
		"http-server": "^14.1.1",
		"lightningcss": "^1.31.1",
		"npm-run-all2": "^8.0.4",
		"playwright": "^1.58.1",
		"storybook": "^10.2.10",
		"tailwindcss": "^4.1.18",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.54.0",
		"vite": "^7.3.1",
		"vite-plugin-dts": "^4.5.4",
		"vite-plugin-lib-inject-css": "^2.2.2",
		"vitest": "^4.0.18",
		"vue-eslint-parser": "^10.4.0",
		"vue-tsc": "^3.2.4"
	},
	"peerDependencies": {
		"vue": ">=3.5.0"
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	}
}
